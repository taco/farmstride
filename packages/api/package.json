{
    "name": "@farmstride/api",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch src/index.ts",
        "build": "pnpm run prisma:generate && tsc && tsc-alias",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "prisma:seed:e2e": "tsx prisma/seedE2E.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:voice": "tsx scripts/test-voice-parse.ts"
    },
    "dependencies": {
        "@apollo/server": "^5.4.0",
        "@apollo/subgraph": "^2.12.2",
        "@as-integrations/fastify": "^3.1.0",
        "@fastify/cors": "^11.2.0",
        "@fastify/multipart": "^9.4.0",
        "@fastify/otel": "0.20.1",
        "@fastify/rate-limit": "^10.3.0",
        "@graphql-tools/utils": "^10.11.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/core": "^2.11.0",
        "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
        "@opentelemetry/instrumentation": "0.222.0",
        "@opentelemetry/instrumentation-graphql": "0.70.0",
        "@opentelemetry/instrumentation-http": "0.222.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-trace-base": "^2.11.0",
        "@opentelemetry/sdk-trace-node": "^2.11.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@prisma/adapter-pg": "^7.1.0",
        "@prisma/client": "^7.1.0",
        "@prisma/instrumentation": "7.1.0",
        "@sentry/node": "^10.39.0",
        "@sentry/opentelemetry": "10.39.0",
        "bcrypt": "^6.0.0",
        "dataloader": "^2.2.3",
        "dotenv": "^17.2.3",
        "fastify": "^5.7.4",
        "graphql": "^16.12.0",
        "graphql-scalars": "^1.25.0",
        "jsonwebtoken": "^9.0.3",
        "openai": "^6.17.0",
        "pg": "^8.16.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.2",
        "@types/pg": "^8.15.6",
        "csv-parse": "^6.1.0",
        "prisma": "^7.1.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.15"
    }
}
