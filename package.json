{
    "name": "farmstride",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "init": "pnpm install && pnpm --filter api prisma:generate",
        "dev": "node scripts/dev.mjs",
        "dev:api": "pnpm --filter api dev",
        "dev:web": "pnpm --filter web dev",
        "build": "pnpm --filter api build && pnpm --filter web build",
        "build:api": "pnpm --filter api build",
        "build:web": "pnpm --filter web build",
        "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md}\"",
        "typecheck": "pnpm -r run typecheck",
        "check": "pnpm format:check && pnpm typecheck",
        "test": "pnpm --filter api test && pnpm --filter web test",
        "test:e2e": "pnpm --filter e2e test",
        "test:e2e:dev": "node scripts/e2e-dev.mjs",
        "test:e2e:ui": "pnpm --filter e2e test:ui",
        "env:local": "ln -sf ../../.env.api.local packages/api/.env && echo 'Switched to local database'",
        "env:neon-dev": "ln -sf ../../.env.api.neon-dev packages/api/.env && echo 'Switched to Neon dev database'",
        "env:neon-prod": "ln -sf ../../.env.api.neon-prod packages/api/.env && echo 'Switched to Neon production database'",
        "env:status": "readlink packages/api/.env || echo 'Not a symlink'",
        "prisma:migrate:deploy": "pnpm --filter api prisma:migrate:deploy",
        "prisma:studio": "pnpm --filter api prisma:studio",
        "prepare": "husky",
        "db:sync-remote-dev": "node scripts/sync-remote-dev.mjs",
        "db:delete-remote-dev": "node scripts/delete-branch.mjs"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "prettier": "^3.7.4"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
